# User-level sqruff config (SQL lint + format). sqruff only reads a config file in the directory it runs in, so this one
# is used when that directory has none (.sqruff, .sqruff.ini, sqruff.toml, .sqlfluff, pyproject.toml [tool.sqruff]):
#   nvim: lsp.lua starts the sqruff language server in ~/.config/sqruff for SQL files outside a sqruff project
#   zsh:  the `sqruff` function in .zshrc adds `--config` pointing here (and says so on stderr)
# Without it sqruff's defaults are dialect ansi and 80 columns. Rules: `sqruff rules`.
[sqruff]
dialect = postgres
max_line_length = 120
