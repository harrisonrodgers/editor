# --- Commits and signing ---
[commit]
    verbose = true  # Show the diff of what is being committed below the message in the editor
[tag]
    sort = version:refname  # v1.10 sorts after v1.9

# --- Repository and remote workflow ---
[init]
    defaultBranch = master
[fetch]
    prune = true  # Remove remote-tracking branches that no longer exist upstream
    pruneTags = true  # Likewise for local tags deleted upstream
[pull]
    rebase = true
[push]
    autoSetupRemote = true  # `git push` on a new branch sets the upstream automatically
[rebase]
    autoStash = true
    abbreviateCommands = true  # `git rebase -i` todo list uses `p` instead of `pick`, so changing to f/s/r is one keystroke
    missingCommitsCheck = error  # Refuse to rebase if a line was accidentally deleted from the todo list
[rerere]
    enabled = true  # Remember how conflicts were resolved and reapply them
[credential]
    helper = cache --timeout=157680000  # Cache username + password
[help]
    autocorrect = prompt

# --- Aliases ---
[alias]
    s = status
    c = checkout
    # difftastic aliases: `git dlog -p` is `git log -p` with difftastic, likewise for the others
    ddiff = -c diff.external=difft diff
    dlog = -c diff.external=difft log --ext-diff
    dshow = -c diff.external=difft show --ext-diff
    ndiff = difftool --dir-diff

# --- Output: log format and pager ---
[log]
    decorate = true
[branch]
    sort = -committerdate  # `git branch` lists most recently used first
[column]
    ui = auto  # `git branch` and `git tag` output in columns
[status]
    showUntrackedFiles = all  # List files inside untracked directories, not just the directory
[format]
    pretty = custom
[pretty]
    custom = format:%C(auto)%H%d%Creset%nAuthor: %Cgreen%ad%Creset %aN <%aE> %Cgreen%ar%Creset%n%C(dim)Commit: %cd %cN <%cE> %cr%Creset%n%C(bold)%s%Creset%n
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n/N to jump between files in the pager
    line-numbers = true
    light = true

# --- Diff and merge ---
[diff]
    algorithm = histogram
    colorMoved = default
    mnemonicPrefix = true  # a/ b/ become i/ w/ c/ (index, worktree, commit) to show what is being compared
    renames = copies  # Detect copied files as well as renamed ones
    tool = nvimdiff
[merge]
    conflictStyle = zdiff3
    tool = nvimdiff3
# mergiraf: syntax-aware merge driver (resolves conflicts that only look like conflicts line by line, e.g. both
# sides adding a different import or json key). Used for every file via ~/.config/git/attributes (`* merge=mergiraf`);
# files it can't parse fall back to git's line-based merge. `mergiraf solve <file>` resolves markers already in a file,
# `mergiraf review <id>` shows what it changed (it prints the id during the merge).
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

# --- Diff and merge tools ---
[difftool]
    prompt = false  # Do not ask yes/no before launching
    trustExitCode = true  # Be able to abort by exiting vim with a non-zero exit code (`:cq` or `:cquit`).
[mergetool]
    prompt = false  # Do not ask yes/no before launching
    trustExitCode = true  # Be able to abort by exiting vim with a non-zero exit code (`:cq` or `:cquit`).
