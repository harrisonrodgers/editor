[commit]
    gpgSign = true
[tag]
    gpgSign = true

[alias]
    s = status
    co = checkout
    # difftastic aliases: `git dlog -p` is `git log -p` with difftastic, likewise for the others
    ddiff = -c diff.external=difft diff
    dlog = -c diff.external=difft log --ext-diff
    dshow = -c diff.external=difft show --ext-diff

[init]
    defaultBranch = master
[fetch]
    # Remove remote-tracking branches that no longer exist upstream
    prune = true
[pull]
    rebase = True
[push]
    # `git push` on a new branch sets the upstream automatically
    autoSetupRemote = true
[rebase]
    autoStash = true
[rerere]
    # Remember how conflicts were resolved and reapply them
    enabled = true

[log]
    decorate = true
[format]
    pretty = custom
[pretty]
    custom = format:%C(auto)%H%d%Creset%nAuthor: %Cgreen%ad%Creset %aN <%aE> %Cgreen%ar%Creset%n%C(always,dim)Commit: %cd %cN <%cE> %cr%Creset %G? %GK %GS%n%C(always,bold)%s%Creset%n

[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    # use n/N to jump between files in the pager
    navigate = true
    line-numbers = true
    light = true

[diff]
    algorithm = histogram
    colorMoved = default
    tool = vimdiff3
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[difftool "vimdiff3"]
    path = nvim
[difftool]
    # Do not ask yes/no before launching
    prompt = false
    # Be able to abort by exiting vim with a non-zero exit code (`:cq` or `:cquit`).
    trustExitCode = true

[merge]
    conflictStyle = zdiff3
    # Do not ask yes/no before launching
    tool = vimdiff3
[mergetool "vimdiff3"]
    path = nvim
[mergetool]
    # Do not ask yes/no before launching
    prompt = false
    # Be able to abort by exiting vim with a non-zero exit code (`:cq` or `:cquit`).
    trustExitCode = true

# Cache username + password for 5 years to avoid having to type username + password
[credential]
    helper = cache --timeout=157680000
